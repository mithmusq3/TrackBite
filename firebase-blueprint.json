{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and dietary tolerance settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "displayName", "email"]
    },
    "NutritionLog": {
      "title": "NutritionLog",
      "description": "Nutritional intake and macronutrient log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "meal": { "type": "string", "maxLength": 200 },
        "portion": { "type": "string", "maxLength": 100 },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "fiber": { "type": "number" },
        "sodium": { "type": "number" },
        "potassium": { "type": "number" },
        "keyVitamins": { "type": "array" },
        "isEstimated": { "type": "boolean" },
        "confidence": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "userId", "timestamp", "meal", "calories"]
    },
    "GutHealthLog": {
      "title": "GutHealthLog",
      "description": "Clinical IBS risk and FODMAP response entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "mealReferenceId": { "type": "string", "maxLength": 128 },
        "mealName": { "type": "string", "maxLength": 200 },
        "ibsRiskLevel": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "identifiedTriggers": { "type": "array" },
        "fodmapCategories": { "type": "object" },
        "predictiveDigestiveReaction": { "type": "string", "maxLength": 1000 },
        "aiRecommendation": { "type": "string", "maxLength": 1000 },
        "groundingReference": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "timestamp", "mealName", "ibsRiskLevel"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user identity and profile metadata"
    },
    "/nutrition_logs/{logId}": {
      "schema": { "$ref": "#/entities/NutritionLog" },
      "description": "Stores nutritional entries per user"
    },
    "/gut_health_logs/{logId}": {
      "schema": { "$ref": "#/entities/GutHealthLog" },
      "description": "Stores gut health and clinical FODMAP reactions per user"
    }
  }
}
